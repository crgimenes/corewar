(let ((line (str-trim (input-text))))
  (let ((parts (str-split " " line)))
    (let ((cmd (str-lower (nth parts 0)))
          (rest (if (> (length parts) 1) (str-trim (nth parts 1)) "")))
      (let ((path (if (digits? rest) (at-index (number rest)) "")))
        (cond
          ((is-empty line) (set note ""))
          ((chose cmd "f" "fight") (set note (cw-fight)))
          ((= cmd "+")
            (if (is-empty path)
              (set note "no warrior with that number")
              (if (cw-add path) (set note "") (set note "eight is as many as the core takes"))))
          ((= cmd "-") (do (cw-drop) (set note "")))
          ((chose cmd "c" "clear") (do (cw-clear) (set note "")))
          ((chose cmd "e" "edit")
            (if (is-empty path)
              (set note "no warrior with that number")
              (set note (cw-edit path))))
          ((chose cmd "n" "new")
            (if (is-empty rest)
              (set note "a name for the new warrior?")
              (set note (cw-edit (with-red rest)))))
          ((chose cmd "h" "help") (set note (cw-manual)))
          (else (set note "+ N · - · c · e N · n NAME · f · h")))))))
