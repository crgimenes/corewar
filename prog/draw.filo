(footer "corewar")

(attr A_BOLD)
(print-at 1 2 "Core War")
(attr 0)
(attr A_DIM)
(print-at 1 12 "up to eight warriors, one core, ten rounds")
(attr 0)

; who is fighting, in the colours the arena paints them
(let ((n (cw-count)))
  (do
    (map
      (fn (i)
        (let ((row (+ 3 i)))
          (fg (cw-colour i))
          (print-at row 2 (str-fmt "%d" (+ i 1)))
          (print-at row 5 (base (cw-picked i)))
          (fg C_DEFAULT)))
      (range n))
    (let ((top (+ 4 n)) (ws (cw-library)))
      (do
        (attr A_DIM)
        (print-at top 2 "warriors")
        (attr 0)
        (map
          (fn (i)
            (letv (path tag) (nth ws i)
              (let ((row (+ top 1 i)))
                (fg 6)
                (print-at row 2 (str-fmt "%3d" (+ i 1)))
                (fg C_DEFAULT)
                (print-at row 7 (base path))
                (attr A_DIM)
                (print-at row 30 tag)
                (attr 0))))
          (range (length ws)))
        (let ((foot (+ top 2 (length ws))))
          (attr A_DIM)
          (print-at foot 2 "+ N joins · - drops the last · c clears · e N edit · n NAME new")
          (print-at (+ foot 1) 2 "f fight · h the Redcode manual · ESC leaves")
          (attr 0)
          (if (not (is-empty note))
            (do (fg 3) (print-at (+ foot 3) 2 note) (fg C_DEFAULT)))
          (attr A_BOLD)
          (print-at (+ foot 4) 2 "Pick:")
          (attr 0)
          (input-at (+ foot 4) 8 30 24 #f))))))
